# Map configuration.
# Copy this file to .env.local and fill in what you need.
# .env.local is gitignored and never committed.

# Bring your own basemap: a MapLibre style.json URL, API key included in the URL.
# Overrides mapProvider/mapStyleId for every tour. Leave blank to use OpenFreeMap.
# e.g. https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
VITE_MAP_STYLE=

# ─── Keys for the built-in raster providers ──────────────────────────────────

# Mapbox — https://account.mapbox.com/access-tokens/
VITE_MAPBOX_API_KEY=

# Jawg Maps — https://www.jawg.io/lab/access-tokens
VITE_JAWG_API_KEY=

# MapTiler — https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_API_KEY=

# CARTO — https://carto.com/basemaps/apikey (required since Aug 2026)
VITE_CARTO_API_KEY=

# OpenFreeMap (the default) needs no key.
